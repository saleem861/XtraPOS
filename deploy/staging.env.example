# Non-secret template for /etc/xtrapos/staging.env on the staging host only.
# xtrapos-staging.service loads that file. Do not put the password in git.

STAGING_WEB_URL=https://test-pos.sharbelfashion.com
STAGING_API_URL=https://test-pos.sharbelfashion.com
ASPNETCORE_ENVIRONMENT=Staging
Passkey__RpId=test-pos.sharbelfashion.com
Passkey__PublicBaseUrl=https://test-pos.sharbelfashion.com
Passkey__Origins__0=https://test-pos.sharbelfashion.com
DataProtection__KeyPath=/opt/xtrapos-staging/shared/data-protection-keys
DataProtection__ApplicationName=XtraPOS.Staging
# SqlServerOptions has Server, Database, User, and Password. There is no Port key.
# Port 10173 belongs in SqlServer__Server. Set SqlServer__Password only in the host file.
SqlServer__Server=69.30.235.148,10173
SqlServer__Database=XtraPOS_Branch_Test_Staging
SqlServer__User=xtrapos_staging
# Membership stays off until a later staging validation. Set client id and secret only in the host file.
Membership__Enabled=false
Membership__GoogleLoginEnabled=false
Membership__AppleLoginEnabled=false
Membership__RequireVerificationForSpecialPrices=false
Membership__PublicOrigin=https://test-pos.sharbelfashion.com
STAGING_ROOT=
STAGING_HOST=
